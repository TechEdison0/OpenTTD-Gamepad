@@ -0,0 +1,110 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+package org.openttd.android;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * On-screen joystick to scroll the map, shown over the game. Only touches
+ * that start on the joystick are taken; other fingers keep driving the cursor.
+ */
+public class JoystickView extends View {
+    private final Paint base_paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint ring_paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint knob_paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    /** Position of the knob relative to the centre, -1..1. */
+    private float knob_x = 0, knob_y = 0;
+    /** Pointer currently moving the knob, or -1. */
+    private int pointer_id = -1;
+
+    /** Pass the joystick position to the game; see android_main.cpp. */
+    private static native void nativeSetJoystick(float x, float y);
+
+    public JoystickView(Context context) {
+        super(context);
+        base_paint.setColor(0x40000000);
+        ring_paint.setColor(0x80FFFFFF);
+        ring_paint.setStyle(Paint.Style.STROKE);
+        ring_paint.setStrokeWidth(2 * getResources().getDisplayMetrics().density);
+        knob_paint.setColor(0xB0FFFFFF);
+    }
+
+    private float radius() {
+        return Math.min(getWidth(), getHeight()) / 2.0f;
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float cx = getWidth() / 2.0f;
+        float cy = getHeight() / 2.0f;
+        float r = radius();
+        canvas.drawCircle(cx, cy, r - ring_paint.getStrokeWidth(), base_paint);
+        canvas.drawCircle(cx, cy, r - ring_paint.getStrokeWidth(), ring_paint);
+        float knob_travel = r * 0.6f;
+        canvas.drawCircle(cx + knob_x * knob_travel, cy + knob_y * knob_travel, r * 0.4f, knob_paint);
+    }
+
+    private void moveKnob(float x, float y) {
+        float r = radius();
+        float dx = (x - getWidth() / 2.0f) / r;
+        float dy = (y - getHeight() / 2.0f) / r;
+        float len = (float)Math.hypot(dx, dy);
+        if (len > 1) {
+            dx /= len;
+            dy /= len;
+        }
+        setKnob(dx, dy);
+    }
+
+    private void setKnob(float x, float y) {
+        knob_x = x;
+        knob_y = y;
+        nativeSetJoystick(x, y);
+        invalidate();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN: {
+                /* Only react to touches on the round joystick itself, not its square corners. */
+                float r = radius();
+                if (Math.hypot(event.getX() - getWidth() / 2.0f, event.getY() - getHeight() / 2.0f) > r) return false;
+                pointer_id = event.getPointerId(0);
+                moveKnob(event.getX(), event.getY());
+                return true;
+            }
+
+            case MotionEvent.ACTION_MOVE: {
+                int index = event.findPointerIndex(pointer_id);
+                if (index >= 0) moveKnob(event.getX(index), event.getY(index));
+                return true;
+            }
+
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                pointer_id = -1;
+                setKnob(0, 0);
+                return true;
+
+            default:
+                return true;
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        setKnob(0, 0);
+    }
+}
diff --git a/os/android/app/src/main/java/org/openttd/android/LauncherActivity.java b/os/android/app/src/main/java/org/openttd/android/LauncherActivity.java
new file mode 100644
index 0000000..b6ec4e3
--- /dev/null
+++ b/os/android/app/src/main/java/org/openttd/android/LauncherActivity.java
@@ -0,0 +1,220 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+package org.openttd.android;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.content.pm.ShortcutInfo;
+import android.content.pm.ShortcutManager;
+import android.graphics.drawable.Icon;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Collections;
+
+/** Entry point: makes sure the game data is extracted, then starts the game. */
+public class LauncherActivity extends Activity {
+    /** Intent extra with command line arguments for OpenTTD; see {@link OpenTTDActivity#getArguments()}. */
+    static final String EXTRA_ARGS = "args";
+
+    private TextView label;
+    private ProgressBar bar;
+    /** Waiting for the user to grant "All files access" for the public folder. */
+    private boolean waiting_for_permission = false;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addAppShortcuts();
+
+        if (DataInstaller.isInstalled(this) && StorageLocation.wasAsked(this) && StorageLocation.getPendingCopy(this) == null) {
+            startGame();
+            return;
+        }
+
+        LinearLayout layout = new LinearLayout(this);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setGravity(Gravity.CENTER);
+        int pad = (int)(32 * getResources().getDisplayMetrics().density);
+        layout.setPadding(pad, pad, pad, pad);
+
+        label = new TextView(this);
+        label.setGravity(Gravity.CENTER);
+        layout.addView(label);
+
+        bar = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setIndeterminate(false);
+        layout.addView(bar, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));
+        setContentView(layout);
+
+        if (DataInstaller.isInstalled(this)) {
+            askStorageLocation();
+        } else {
+            installData();
+        }
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+
+        /* Back from the permission screen. */
+        if (waiting_for_permission) {
+            waiting_for_permission = false;
+            if (StorageLocation.hasAllFilesAccess(this)) {
+                usePublicFolder();
+            } else {
+                StorageLocation.setAsked(this);
+                Toast.makeText(this, R.string.location_later, Toast.LENGTH_LONG).show();
+                startGame();
+            }
+        }
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
+        /* Handled in onResume, which is called after this. */
+    }
+
+    /** Add "App settings" to the menu of the app icon (long-press). */
+    private void addAppShortcuts() {
+        ShortcutManager manager = getSystemService(ShortcutManager.class);
+        if (manager == null) return;
+        ShortcutInfo settings = new ShortcutInfo.Builder(this, "settings")
+                .setShortLabel(getString(R.string.storage_shortcut))
+                .setIcon(Icon.createWithResource(this, R.mipmap.ic_launcher))
+                .setIntent(new Intent(Intent.ACTION_VIEW).setClass(this, StorageActivity.class))
+                .build();
+        manager.setDynamicShortcuts(Collections.singletonList(settings));
+    }
+
+    /** Extract the game data from the APK, then continue the start up. */
+    private void installData() {
+        label.setText(R.string.installing_data);
+        new Thread(() -> {
+            try {
+                DataInstaller.install(this, (done, total) -> runOnUiThread(() -> {
+                    bar.setMax(total);
+                    bar.setProgress(done);
+                }));
+                runOnUiThread(this::askStorageLocation);
+            } catch (Exception e) {
+                runOnUiThread(() -> new AlertDialog.Builder(this)
+                        .setTitle(R.string.app_name)
+                        .setMessage(getString(R.string.install_failed, e.toString()))
+                        .setPositiveButton(android.R.string.ok, (d, w) -> finish())
+                        .setCancelable(false)
+                        .show());
+            }
+        }, "openttd-install").start();
+    }
+
+    /** Ask once whether to keep the personal files in a folder that is easy to reach. */
+    private void askStorageLocation() {
+        if (StorageLocation.wasAsked(this)) {
+            startGame();
+            return;
+        }
+
+        bar.setVisibility(ProgressBar.INVISIBLE);
+        label.setText("");
+        new AlertDialog.Builder(this)
+                .setTitle(R.string.location_title)
+                .setMessage(getString(R.string.location_question, StorageLocation.getPublicDir().getAbsolutePath()))
+                .setPositiveButton(R.string.location_public, (d, w) -> {
+                    if (StorageLocation.hasAllFilesAccess(this)) {
+                        usePublicFolder();
+                    } else {
+                        waiting_for_permission = true;
+                        StorageLocation.requestAllFilesAccess(this);
+                    }
+                })
+                .setNegativeButton(R.string.location_app, (d, w) -> {
+                    StorageLocation.setAsked(this);
+                    startGame();
+                })
+                .setCancelable(false)
+                .show();
+    }
+
+    /** Copy the personal files to the new storage location, then start the game. */
+    private void copyThenStart(File from, File to) {
+        label.setText(R.string.storage_copying);
+        bar.setVisibility(ProgressBar.VISIBLE);
+        bar.setIndeterminate(true);
+
+        new Thread(() -> {
+            try {
+                StorageLocation.copyContents(from, to);
+                runOnUiThread(this::startGame);
+            } catch (Exception e) {
+                runOnUiThread(() -> new AlertDialog.Builder(this)
+                        .setTitle(R.string.storage_title)
+                        .setMessage(getString(R.string.storage_copy_failed_start, e.getMessage()))
+                        .setPositiveButton(android.R.string.ok, (d, w) -> startGame())
+                        .setCancelable(false)
+                        .show());
+            }
+        }, "openttd-copy").start();
+    }
+
+    /** Switch to the public folder, copying the files from the app folder. */
+    private void usePublicFolder() {
+        File from = StorageLocation.getDefaultDir(this);
+        File to = StorageLocation.getPublicDir();
+        label.setText(R.string.storage_copying);
+        bar.setVisibility(ProgressBar.VISIBLE);
+        bar.setIndeterminate(true);
+
+        new Thread(() -> {
+            try {
+                if (!to.isDirectory() && !to.mkdirs()) throw new IOException(to.getAbsolutePath());
+                StorageLocation.copyContents(from, to);
+                StorageLocation.setCustomDir(this, to);
+                StorageLocation.setAsked(this);
+                runOnUiThread(this::startGame);
+            } catch (Exception e) {
+                runOnUiThread(() -> new AlertDialog.Builder(this)
+                        .setTitle(R.string.location_title)
+                        .setMessage(getString(R.string.storage_copy_failed, e.getMessage()))
+                        .setPositiveButton(android.R.string.ok, (d, w) -> {
+                            StorageLocation.setAsked(this);
+                            startGame();
+                        })
+                        .setCancelable(false)
+                        .show());
+            }
+        }, "openttd-copy").start();
+    }
+
+    private void startGame() {
+        /* Files to bring along to a newly chosen storage location? */
+        File copy_from = StorageLocation.getPendingCopy(this);
+        if (copy_from != null) {
+            StorageLocation.setPendingCopy(this, null);
+            if (copy_from.isDirectory()) {
+                copyThenStart(copy_from, StorageLocation.getEffectiveDir(this));
+                return;
+            }
+        }
+
+        Intent intent = new Intent(this, OpenTTDActivity.class);
+        String args = getIntent().getStringExtra(EXTRA_ARGS);
+        if (args != null) intent.putExtra(EXTRA_ARGS, args);
+        startActivity(intent);
+        overridePendingTransition(0, 0);
+        finish();
+    }
+}
diff --git a/os/android/app/src/main/java/org/openttd/android/OnScreenControls.java b/os/android/app/src/main/java/org/openttd/android/OnScreenControls.java
